{
  "expo": {
    "name": "sunote",
    "slug": "sunote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "sunotedemo",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wilhelmaoi.sunotedemo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      "react-native-edge-to-edge"
    ],
    "extra": {
      "eas": {
        "projectId": "2c9d818d-2815-4572-875c-ce54139dec24"
      }
    },
    "owner": "wilhelmaoi"
  }
}
