{
  "expo": {
    "name": "sunote",
    "slug": "sunote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "sunotedemo",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "需要访问相册以保存支付码图片"
      }
    },
    "android": {
      "package": "com.wilhelmaoi.sunotedemo",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FACAB0FF",
          "image": "./assets/icon.png",
          "resizeMode": "cover"
        }
      ],
      "react-native-edge-to-edge",
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "2c9d818d-2815-4572-875c-ce54139dec24"
      }
    },
    "owner": "wilhelmaoi"
  }
}
